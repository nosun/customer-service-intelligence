<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dressafford.customer-service-intelligence.scheduler</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/php@8.4/bin/php</string>
        <string>artisan</string>
        <string>schedule:work</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/guohuawei/dev/customer-service-intelligence</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/guohuawei/dev/customer-service-intelligence/storage/logs/scheduler.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/guohuawei/dev/customer-service-intelligence/storage/logs/scheduler-error.log</string>
</dict>
</plist>
